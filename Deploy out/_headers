# ==============================================================================
# Cloudflare Pages / Workers Performance & Cache Directives
# Dr. Chandra Sekar Anam Dental Suite
# ==============================================================================

# HTML Documents: Revalidate immediately so new deployments show instantly
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/specialisations/*
  Cache-Control: public, max-age=0, must-revalidate
/locations/*
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheets & Scripts: Immediate revalidation (busts any CDN cache)
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Images & Static Assets
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Robots & Sitemap
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
